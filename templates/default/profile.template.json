{
  "$schema": "~/.nono-here/nono-profile.schema.json",
  "extends": [
    "nolabs-ai/claude",
    "nolabs-ai/opencode-v1",
    "nolabs-ai/pi"
  ],
  "meta": {
    "name": "NAME",
    "version": "2"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [],
    "deny": ["~/.gitconfig"],
    "read_file": [
      "~/.gitconfig-private",
      "~/.gitconfig-work",
      "~/.gitconfig-agents",
      "~/.gitignore",
      "~/.bashrc",
      "~/.bashprofile"
    ],
    "read": ["~/.CFUserTextEncoding"],
    "bypass_protection": ["~/.bashrc", "~/.bashprofile"]
  },
  "network": {
    "allow_domain": [],
    "open_port": [12100],
    "open_port_range": [[11400, 11500]]
  },
  "environment": {
    "allow_vars": [
      "HOME",
      "SHELL",
      "TERM",
      "PATH",
      "LSCOLORS",
      "LS_COLORS",
      "LC_ALL",
      "LANG",
      "PWD",
      "USER",
      "EDITOR",
      "OPENCODE_ENABLE_EXA",
      "OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS",
      "OMLX_PORT",
      "OMLX_API_KEY",
      "APFEL_PORT",
      "APFEL_TOKEN",
      "DO_NOT_TRACK"
    ],
    "set_vars": {
      "GIT_CONFIG_GLOBAL": "~/.gitconfig-agents",
      "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
      "CLAUDE_CODE_HIDE_CWD": "1",
      "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
      "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
      "CLAUDE_CODE_MAX_TURNS": "200",
      "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "0",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "DISABLE_AUTO_COMPACT": "1",
      "DISABLE_FEEDBACK_COMMAND": "1",
      "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
      "DISABLE_UPGRADE_COMMAND": "1"
    }
  }
}
